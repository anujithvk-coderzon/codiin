generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  type       UserType
  name       String
  email      String
  phone      String
  program    String
  experience String?
  message    String?
  createdAt  DateTime @default(now())

  @@index([program])
  @@index([createdAt])
}

model Visit {
  id        String   @id @default(uuid())
  ip        String
  path      String?
  source    String?
  campaign  String?
  userAgent String?
  visitorId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
}


model Internship {
  id            String   @id @default(uuid())
  fullName      String
  email         String
  phone         String
  program       String
  duration      String
  college       String
  course        String
  year_of_study String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model Event {
  id                 String              @id
  slug               String              @unique
  name               String
  description        String
  startDate          DateTime
  endDate            DateTime
  syllabus           Json?               @default("[]")
  feesStructure      Json?               @default("[]")
  importantLinks     Json?               @default("[]")
  imageUrl           String?
  mode               modeType            @default(ONLINE)
  address            String?
  whoShouldAttend    String[]
  trainerDetails     Json?               @default("[]")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  benefits           String[]
  isPaidEvent        Boolean             @default(false)
  applicationEndDate String
  eventRegistrations EventRegistration[]

  @@index([startDate])
}

enum UserType {
  REGISTER
  CONTACT
}

enum modeType {
  ONLINE
  OFFLINE
}

model EventRegistration {
  id         String   @id @default(uuid())
  slug       String
  name       String
  mobile     String
  email      String
  college    String
  course     String
  yearOfPass DateTime
  howYouKnow String
  createdAt  DateTime @default(now())
  event      Event    @relation(fields:[slug], references: [slug])
  @@index([slug, email])
  @@index([slug])
  @@index([createdAt])
}
