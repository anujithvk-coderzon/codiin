generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id
  type       UserType
  name       String
  email      String
  phone      String
  program    String
  experience String?
  message    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([program])
}

model Visit {
  id        String   @id
  ip        String
  createdAt DateTime @default(now())

  @@index([createdAt, ip])
}

model Internship {
  id            String   @id
  fullName      String
  email         String
  phone         String
  program       String
  duration      String
  college       String
  course        String
  year_of_study String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

enum UserType {
  REGISTER
  CONTACT
}


