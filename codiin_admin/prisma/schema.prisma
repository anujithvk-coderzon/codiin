generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id
  name       String
  email      String
  phone      String
  program    String
  createdAt  DateTime @default(now())
  experience String?

  @@index([createdAt])
  @@index([program])
}
